# Cloudflare Pages routing for Next static export (trailingSlash: true).
# Requires post-build removal of out/404.html (see scripts/prepare-cloudflare-out.mjs).
# Do NOT add /_next/* rewrites — chunk URLs must not return index.html.

# Shared links without trailing slash → canonical /products/<slug>/ (prebuilt index.html).
/products/:slug  /products/:slug/  301

# Slug not pre-rendered at build → client PDP shell (URL unchanged).
/products/*  /products/_pdp/index.html  200

# Other deep links (orders, etc.)
/*  /index.html  200
