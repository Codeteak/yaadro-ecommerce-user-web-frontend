# Cloudflare Pages: static files win first; these rules handle legacy / missing paths.

# Legacy query-style product links → slug path (production static HTML ignores ?id= at build time)
/product?id=:id  /products/:id/  302

# Bare legacy product route (avoid pre-rendered "Missing product id" page)
/product  /products/  302
/product/  /products/  302

# Pretty PDP URLs with no pre-rendered HTML → client PDP shell (static files win first)
/products/*  /products/detail/index.html  200

# SPA fallback when no static file exists (do not rewrite /_next/*)
/*  /index.html  200
