# Immutable Next.js build assets (must stay cacheable; do not rewrite these URLs)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# HTML shell — avoid stale index.html referencing removed JS chunks after deploy
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

# Always revalidate service worker + manifest so installs pick up updates
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/javascript; charset=utf-8
/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

# Security headers (all responses)
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
