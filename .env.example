# Production hostnames (Cloudflare Pages custom domains):
#   testshop.yaadro.online, marketfresh.in
# Backend tenant resolver must know each hostname (NEXT_PUBLIC_TENANT_RESOLVER_URL).

# Prefer setting the full base URL (includes /api)
NEXT_PUBLIC_API_BASE_URL=https://frontend.yaadro.online/api
#
# Backward-compatible (if you keep this, the app will treat it as https://.../api)
NEXT_PUBLIC_API_URL=https://frontend.yaadro.online

# ---------------------------------------------------------------------------
# Optional: local GET-only catalog from Postgres/Supabase (npm run dev only).
# Server-side secret — NEVER use NEXT_PUBLIC_ for this.
# When set, Next Route Handlers serve:
#   GET /api/storefront/products
#   GET /api/storefront/products/:id
#   GET /api/storefront/categories
# When unset, those routes proxy to the upstream API (same as before).
# Production static export (Cloudflare Pages) does not run these handlers —
# use a read-only DB user + a Node host, or keep using the backend API.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# STOREFRONT_DB_PRODUCTS_TABLE=products
# STOREFRONT_DB_CATEGORIES_TABLE=categories
# ---------------------------------------------------------------------------

# Default shop ID for local development only.
# Used only when NODE_ENV is not "production".
NEXT_PUBLIC_SHOP_ID=c0000001-0000-4000-8000-000000000001

# Production tenant resolver endpoint (domain -> shopId).
# App sends GET ?domain=<current-domain>, expected response contains one of:
# { shopId } or { shop_id } or { data: { shopId } }.
# Example: https://api.yourdomain.com/api/shops/resolve-by-domain
NEXT_PUBLIC_TENANT_RESOLVER_URL=

# Refresh-token session length on this device (default 50 days; does not extend on each page view).
# NEXT_PUBLIC_AUTH_REFRESH_TOKEN_DAYS=50
# Legacy alias: NEXT_PUBLIC_AUTH_SESSION_DAYS=50
# Access tokens (7 days) are refreshed automatically before JWT expiry.

# Google Maps JavaScript API key (required for address map picker/search)
# Enable APIs: Maps JavaScript API, Geocoding API, Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Storefront catalog realtime (Socket.IO catalog.invalidated on admin price edits)
# Must match customer API STOREFRONT_CATALOG_REALTIME_TOKEN. Customer API needs REALTIME_ENABLED=true.
# Socket connects to customer API origin (not Next /api proxy). Tunnel/CDN must forward /socket.io.
# NEXT_PUBLIC_CATALOG_REALTIME_ENABLED=true
# NEXT_PUBLIC_STOREFRONT_CATALOG_REALTIME_TOKEN=
# Optional override when socket host differs from NEXT_PUBLIC_API_URL (no /api suffix):
# NEXT_PUBLIC_CATALOG_REALTIME_URL=http://localhost:4100