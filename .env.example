# Public storefront
NEXT_PUBLIC_SHOP_ID=
NEXT_PUBLIC_API_URL=
# Public site origin for absolute SEO/Open Graph URLs (e.g. https://yaadro.online)
NEXT_PUBLIC_SITE_URL=
# Full URL of the shop-profile endpoint for SEO (name/logo). Leave empty to
# fall back to Yaadro name + purple D logo — API has no shop endpoint yet.
NEXT_PUBLIC_SHOP_PROFILE_URL=

# Server-only. Do not prefix these with NEXT_PUBLIC.
# Postgres connection for catalog reads and the delivery-radius preview.
# The browser never receives this value. Login, checkout, and orders stay on the shop API.
DATABASE_URL=
# Optional. Public base for product and category image keys that are not already https URLs.
OBJECT_STORAGE_PUBLIC_BASE_URL=
# Used when a shop has no delivery radius of its own. Same default as the shop API.
SERVICE_AREA_RADIUS_METERS=5000
STOREFRONT_CATALOG_USE_UPSTREAM=false
# Address detect (Geocoding) + live-order-track map (Maps Embed API).
# Enable both APIs on the Google Cloud key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Shop API request timeout in milliseconds.
NEXT_PUBLIC_API_TIMEOUT_MS=15000
