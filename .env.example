# Public storefront
NEXT_PUBLIC_SHOP_ID=
NEXT_PUBLIC_API_URL=
# Public site origin for absolute SEO/Open Graph URLs (e.g. https://yaadro.online)
NEXT_PUBLIC_SITE_URL=
# Full URL of the shop-profile endpoint for SEO (name/logo). Leave empty to
# fall back to Yaadro name + purple D logo — API has no shop endpoint yet.
NEXT_PUBLIC_SHOP_PROFILE_URL=

# Server-only. Do not prefix these with NEXT_PUBLIC.
DATABASE_URL=
STOREFRONT_CATALOG_USE_UPSTREAM=false
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
