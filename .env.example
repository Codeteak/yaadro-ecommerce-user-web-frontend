# Public storefront
# Local / fallback shop UUID only. Production picks the shop from the request
# hostname via GET /api/shops/resolve-by-domain (one Next server, many domains).
NEXT_PUBLIC_DEFAULT_SHOP_ID=
# Legacy alias — used only when NEXT_PUBLIC_DEFAULT_SHOP_ID is empty.
# NEXT_PUBLIC_SHOP_ID=
NEXT_PUBLIC_API_URL=
# Stay signed in on this device (client clock; default 50 days). Same idea as main.
# NEXT_PUBLIC_AUTH_REFRESH_TOKEN_DAYS=50
# Optional Nominatim base for geocode fallback when Google fails (no email required here).
# NEXT_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org
# Optional. Shop UUID(s) for /api/warm (health probes have no Host header).
# Comma-separated list, or a single STOREFRONT_WARM_SHOP_ID. Falls back to
# NEXT_PUBLIC_DEFAULT_SHOP_ID. Set this to the live shop in multi-shop prod.
# STOREFRONT_WARM_SHOP_ID=
# STOREFRONT_WARM_SHOP_IDS=
# Catalog live prices via Socket.IO on the customer API. Set false if /socket.io 404s locally.
NEXT_PUBLIC_CATALOG_REALTIME_ENABLED=false
NEXT_PUBLIC_STOREFRONT_CATALOG_REALTIME_TOKEN=
NEXT_PUBLIC_CATALOG_REALTIME_URL=
# Public site origin for absolute SEO/Open Graph URLs (e.g. https://yaadro.online)
NEXT_PUBLIC_SITE_URL=
# Full URL of the shop-profile endpoint for SEO (name/logo). Leave empty to
# fall back to Yaadro name + purple D logo — API has no shop endpoint yet.
NEXT_PUBLIC_SHOP_PROFILE_URL=
# Help & Support contact (optional until the shop API exposes phone/address).
# Phone enables Call + WhatsApp. Address lines use | separators. Maps URL optional.
# NEXT_PUBLIC_SHOP_SUPPORT_PHONE=+918045678901
# NEXT_PUBLIC_SHOP_SUPPORT_ADDRESS=12, Amaryllis Ground Floor|Begur Main Road, Bengaluru 560114
# NEXT_PUBLIC_SHOP_SUPPORT_MAPS_URL=https://maps.google.com/?q=Begur+Bengaluru


# Server-only. Do not prefix these with NEXT_PUBLIC.
# Postgres connection for catalog reads and the delivery-radius preview.
# The browser never receives this value. Login, checkout, and orders stay on the shop API.
DATABASE_URL=
# Optional Postgres pool size / connect timeout for multi-shop `/home` (defaults 10 / 5000ms).
# STOREFRONT_DB_POOL_MAX=10
# STOREFRONT_DB_CONNECT_TIMEOUT_MS=5000
# Optional. Public base for product and category image keys that are not already https URLs.
OBJECT_STORAGE_PUBLIC_BASE_URL=
# Used when a shop has no delivery radius of its own. Same default as the shop API.
SERVICE_AREA_RADIUS_METERS=5000
STOREFRONT_CATALOG_USE_UPSTREAM=false
# Address map (Maps JavaScript API) + Geocoding + live-track / details (Maps Embed API).
# Enable Maps JavaScript API, Geocoding API, and Maps Embed API on the Google Cloud key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Shop API request timeout in milliseconds.
NEXT_PUBLIC_API_TIMEOUT_MS=15000
