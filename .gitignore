# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Serwist generated workers (keep hand-written public/sw.js tracked)
public/swe-worker*
public/sw.js.map

# Parked during `npm run build:static` if a crash interrupts restore
app/_api_parked_for_static_export
src/app/_api_parked_for_static_export

# Wrangler local state
.wrangler/
.dev.vars

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# husky
.husky/_
