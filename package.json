{
  "name": "yaadro-ecommerce-user-web-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "node scripts/static-export-build.mjs",
    "start": "next start",
    "lint": "next lint",
    "test:otp-payload": "node --test utils/otpVerifyPayload.test.mjs",
    "test:pointer-drag": "node --test utils/pointerDragClick.test.mjs",
    "test:auth-session": "node --import ./scripts/register-extensionless.mjs --test utils/authSession.test.mjs utils/authSessionExpiry.test.mjs",
    "test:address": "node --test utils/addressApi.test.mjs utils/apiErrors.test.mjs lib/validations/address.schema.test.mjs",
    "test:product-detail": "node --test lib/storefrontProductDetail.test.mjs",
    "test:catalog-realtime": "node --import ./scripts/register-extensionless.mjs --test lib/coalesceCatalogRefetch.test.mjs lib/catalogRealtimeSocket.test.mjs lib/catalogRevisionPoll.test.mjs utils/productSizeSelection.test.mjs utils/cartLinePersist.soldByWeight.test.mjs utils/cartPromotions.soldByWeight.test.mjs utils/productUtils.soldByWeight.test.mjs utils/storefrontCheckoutLines.test.mjs lib/applyCatalogProductUpdates.test.mjs",
    "test:sold-by-weight": "node --import ./scripts/register-extensionless.mjs --test utils/productSizeSelection.test.mjs utils/cartLinePersist.soldByWeight.test.mjs utils/cartPromotions.soldByWeight.test.mjs utils/productUtils.soldByWeight.test.mjs utils/storefrontCheckoutLines.test.mjs lib/applyCatalogProductUpdates.test.mjs",
    "verify:catalog-live": "node --env-file=.env scripts/verify-catalog-live-e2e.mjs",
    "tunnel:login": "cloudflared tunnel login",
    "tunnel:run": "cloudflared tunnel --config cloudflared/config.yaml run",
    "pages:dev": "wrangler pages dev out",
    "pages:deploy": "npm run build:static && wrangler pages deploy out --project-name=yaadro-ecommerce-user-web-frontend"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@mingcute/react": "^3.0.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-aria/focus": "^3.22.1",
    "@react-aria/i18n": "^3.13.1",
    "@react-aria/interactions": "^3.28.1",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@react-google-maps/api": "^2.20.8",
    "@tanstack/react-query": "5.96.2",
    "@use-gesture/react": "^10.3.1",
    "eslint-config-next": "14.2.35",
    "framer-motion": "^13.1.0",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.46.0",
    "minisearch": "^7.2.0",
    "next": "14.2.35",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "socket.io-client": "^4.8.3",
    "tailwind-variants": "^3.3.1",
    "workbox-cli": "^7.4.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.2",
    "@tanstack/react-query-devtools": "5.96.2",
    "@types/pg": "^8.21.0",
    "autoprefixer": "10.4.27",
    "eslint": "^8.57.1",
    "postcss": "8.5.9",
    "tailwindcss": "4.2.2",
    "wrangler": "^4.14.0"
  }
}
