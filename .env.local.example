# Copy to `.env.local` for local testing (never commit `.env.local`).

# Server-only Supabase/Postgres URL (GET catalog via Next Route Handlers).
# Prefer a read-only DB user. Rotate any password that was shared/exposed.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Optional table name overrides if discovery fails
# STOREFRONT_DB_PRODUCTS_TABLE=products
# STOREFRONT_DB_CATEGORIES_TABLE=categories

# Shop filter for local catalog
NEXT_PUBLIC_SHOP_ID=c0000001-0000-4000-8000-000000000001

# Upstream API still used for cart/auth/checkout (and catalog if DATABASE_URL is unset)
NEXT_PUBLIC_API_URL=https://customer.yaadro.online
